# IMBIO Server — Environment variables
# Copia este archivo a `.env` y ajusta los valores

# =================================================================
# Server
# =================================================================
# Host donde escucha el servidor. Usa 0.0.0.0 para que las PCs
# clientes de la LAN puedan conectarse.
HOST=0.0.0.0

# Puerto del servidor. Las PCs clientes accederán a:
#   http://<IP-DE-ESTA-PC>:3000
PORT=3000

# Modo: "development" o "production"
NODE_ENV=development

# CORS: orígenes permitidos separados por coma.
# En LAN puedes usar "*" para abrir a toda la red local.
# En producción, mejor lista las IPs explícitas.
CORS_ORIGINS=*

# =================================================================
# Database (PostgreSQL)
# =================================================================
# Conexión a PostgreSQL. Crea la base de datos antes de correr
# las migraciones, por ejemplo:
#   createdb imbio
DATABASE_URL=postgresql://imbio:imbio@localhost:5432/imbio?schema=public

# =================================================================
# Logging
# =================================================================
LOG_LEVEL=info
