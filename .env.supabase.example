# =================================================================
# .env.supabase.example — Variables de entorno para Supabase + Render
# =================================================================
# Copia este archivo a `.env` (NO commitear) y rellena los valores.
# En Render, configura estas mismas variables en el dashboard:
#   https://dashboard.render.com/web/<service-id>/env
# =================================================================

# --- Server ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- Database (Supabase) ---
# 1. Crear proyecto en https://supabase.com
# 2. Ir a Project Settings > Database > Connection string > URI
# 3. Copiar la "Connection string" (Transaction mode, puerto 6543)
# 4. Reemplazar [YOUR-PASSWORD] con la password que Supabase te dio
# 5. AGREGAR al final: ?pgbouncer=true&connection_limit=1
#
# Ejemplo:
# DATABASE_URL=postgresql://postgres.abcdefgh:MiPassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# ⚠️ IMPORTANTE:
# - Usa el connection string "Transaction mode" (puerto 6543), NO "Session mode" (5432)
# - El parámetro ?pgbouncer=true es REQUERIDO porque Supabase usa pgbouncer
# - connection_limit=1 evita agotar el pool de conexiones
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# --- Auth ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUERIDO en producción (mínimo 16 chars, recomendado 64+)
JWT_SECRET=REEMPLAZAR_CON_STRING_ALEATORIO_DE_64_CHARS

JWT_EXPIRES_IN=28800  # 8 horas en segundos

# --- CORS ---
# En dev: * (todos los orígenes)
# En prod con frontend separado: https://tu-frontend.com
CORS_ORIGINS=*

# --- Auto-seed ---
# true = si la BD está vacía, siembra trámites/admin/configuración
# false = no siembra nunca (control manual)
AUTO_SEED=true
